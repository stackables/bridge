{
  "name": "bridge-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test": "pnpm -r test",
    "fuzz": "pnpm -r --filter './packages/*' fuzz",
    "build": "pnpm -r --filter './packages/*' lint:types",
    "lint": "eslint .",
    "test:graphql16": "bash scripts/test-graphql16.sh",
    "smoke": "node scripts/smoke-test-packages.mjs",
    "e2e": "pnpm -r e2e",
    "depcheck": "pnpm -r exec pnpm dlx depcheck",
    "ci:publish": "changeset git-tag && pnpm publish -r --filter '@stackables/*'",
    "test:coverage": "pnpm -r test:coverage",
    "bench": "pnpm -r bench",
    "profile:cpu": "node scripts/profile-cpu.mjs",
    "profile:ticks": "node scripts/profile-v8-ticks.mjs",
    "profile:heap": "node scripts/profile-heap.mjs",
    "profile:deopt": "node scripts/profile-deopt.mjs",
    "profile:flamegraph": "node scripts/flamegraph.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "knip": "knip",
    "mutants": "npx stryker run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "knip": "6.42.1",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
