{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 10-17 * * 1"],
  "minimumReleaseAge": "7 days",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "loadtest/**"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Overrides with a version selector (`undici@>=7.0.0 <7.24.0`) are security floors for that range: moving one a major would force it on the packages that need the old line",
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchDepNames": ["/^.+@/"],
      "enabled": false
    }
  ]
}
