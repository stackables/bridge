{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>stackables/renovate-config"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "loadtest/**"
  ],
  "packageRules": [
    {
      "description": "Test (unit, fuzz, build, lint), CodeQL and the Workers build check every update",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "automerge": true
  }
}
